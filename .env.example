# Copy these into your EC2 user-data / systemd unit / launch template. Never commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-alb-dns-name.elb.amazonaws.com,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-alb-dns-name.elb.amazonaws.com
DJANGO_TIME_ZONE=Asia/Karachi
# Set to 1 only after the ALB has an HTTPS listener
DJANGO_HTTPS=0

# RDS PostgreSQL (if DB_HOST is missing, SQLite is used)
DB_HOST=your-db.xxxxxxxx.region.rds.amazonaws.com
DB_NAME=taskmanager
DB_USER=taskadmin
DB_PASSWORD=change-me
DB_PORT=5432
